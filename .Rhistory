load(here::here("data", "tempsextra.rdata"))
# Create temps_xtra_nice object
temps_xtra_nice <- temps_xtra %>%
filter( ywint != "2019" |
tact > 10) %>%
mutate( heat_off =
ifelse( day_in_year > 258 |
day_in_year < 135,  "on", "off")
)
